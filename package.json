{
  "name": "capabilities-matrix-gh-pages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile-data.cjs",
    "predev": "node scripts/compile-data.cjs",
    "prebuild": "node scripts/compile-data.cjs",
    "serve": "node scripts/compile-data.cjs && .venv\\Scripts\\python.exe -m mkdocs serve",
    "build": "node scripts/compile-data.cjs && .venv\\Scripts\\python.exe -m mkdocs build",
    "build:vite": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
